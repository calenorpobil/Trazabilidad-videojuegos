; Reglas de Nidada compiladas en Rust (rust/nidada-ext). Ver docs/implementacion-android.md, 5.1.
; Los binarios no se versionan: los deja aquí rust/build-ext.sh.
; Las entradas de Android se compilan en la fase J2.
[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.7
reloadable = true

[libraries]
windows.debug.x86_64 = "res://bin/windows-x86_64/nidada_ext.dll"
windows.release.x86_64 = "res://bin/windows-x86_64/nidada_ext.dll"
linux.debug.x86_64 = "res://bin/linux-x86_64/libnidada_ext.so"
linux.release.x86_64 = "res://bin/linux-x86_64/libnidada_ext.so"
android.debug.arm64 = "res://bin/arm64-v8a/libnidada_ext.so"
android.release.arm64 = "res://bin/arm64-v8a/libnidada_ext.so"
android.debug.x86_64 = "res://bin/x86_64/libnidada_ext.so"
android.release.x86_64 = "res://bin/x86_64/libnidada_ext.so"
