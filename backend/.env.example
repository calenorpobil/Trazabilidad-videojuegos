# Configuracion del backend (src/config.ts). Copia este fichero a .env, que git ignora.

# Juego al que sirve este despliegue: [a-z0-9-], de 1 a 32 caracteres.
CHAIN_GAME_ID=chain-demo

# Semilla maestra: 32 bytes en hexadecimal. Exactamente UNA de las dos variables.
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si se pierde, el juego pierde su autoridad; si se filtra, ver el procedimiento de rotacion.
CHAIN_MASTER_SEED_FILE=/ruta/fuera/del/repositorio/chain-demo.seed
# CHAIN_MASTER_SEED=

# Credenciales del contrato HTTP (seccion 2), de 32 caracteres o mas y distintas entre si.
# write_key: solo el servidor de juego. read_token: viaja en el binario del juego.
CHAIN_WRITE_KEY=
CHAIN_READ_TOKEN=

# Opcionales.
# CHAIN_DATABASE_PATH=chain.db
# CHAIN_HOST=127.0.0.1
# CHAIN_PORT=8787
